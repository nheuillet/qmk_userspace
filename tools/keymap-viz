#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#     "keymap-drawer>=0.23",
#     "cairosvg",
# ]
# ///
"""Render a QMK keymap as SVG/PNG with keymap-drawer.

Self-contained uv script: `uv run` (or direct execution) fetches keymap-drawer
and cairosvg into an isolated environment automatically. Reads only — never
writes into the keymap's directory. Output goes to <userspace>/viz/<keyboard>/<keymap>/
by default.

Features:
  - resolves custom macros (ESC_ALT → MT(...)), layer enums, userspace layouts
  - drops the halcyon-module slot row automatically when no HLC_* module
    defines are found in the keymap (--halcyon-modules to force-keep it)
  - shows shifted legends (1 → 1!) and F15-gated accent combos
  - colors keys by type and by the keyboard's RGB layer scheme

Only external requirement: the `qmk` CLI with your QMK_HOME configured
(used to convert keymap.c into QMK keymap.json).

Usage:
  ./tools/keymap-viz -kb <keyboard> -km <keymap> [-o <outdir>] [--no-png]
                     [--layout LAYOUT_foo] [--halcyon-modules]

Example:
  ./tools/keymap-viz -kb splitkb/halcyon/elora -km colemakdh_hlc
"""

import argparse
import configparser
import io
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path

MACRO_RE = re.compile(r"^\s*#define\s+([A-Za-z_]\w*)\s+(.+)$", re.M)
DESIGNATOR_RE = re.compile(r"\[\s*([_A-Za-z][_A-Za-z0-9]*)\s*\]\s*=\s*LAYOUT_?")
MT_RE = re.compile(r"^(MT|LT)\(|^[A-Z_]+_T\(")
LAYER_KEY_RE = re.compile(r"^(MO|DF|TG|TO|TT|OSL)\(\d+\)$")

# --- visual design ----------------------------------------------------------

