<script>
const DATA = __DATA__;

const LAYER_NAMES = DATA.layerNames;
const KC = DATA.kcLabels;
const SHIFTED = DATA.shifted;
const MODS = DATA.modLabels;
const LAYER_KEYS = {};
LAYER_NAMES.forEach((n, i) => LAYER_KEYS[i] = n);
const KEY_INFO = DATA.keyInfo;
const LAYER_COLORS = DATA.layerColors;
const FKEY_COLORS = LAYER_COLORS[DATA.fkeyLayer] || null;

// combos: [keyA, keyB, result, accentType, description] — from combos.c (F15-gated)
const COMBOS = DATA.combos;
const TRIGGERS = DATA.triggers;
const ACCENT_COLORS = {grave:'#b3702f', acute:'#d4a017', circumflex:'#2fa3ad', trema:'#b02f9f', cedilla:'#2f8f52'};
const ACCENT_GROUPS = ['grave', 'acute', 'circumflex', 'trema', 'cedilla'];

// ---- parse helpers ----
function parseToken(tok) {
  const mt = tok.match(/^MT\((MOD_\w+),\s*(\w+)\)$/);
  if (mt) return {tap: KC[mt[2]] ?? mt[2], hold: MODS[mt[1]] ?? mt[1], kind: 'mt', tapTok: mt[2]};
  const mo = tok.match(/^MO\((\d+)\)$/);
  if (mo) return {tap: LAYER_KEYS[mo[1]], kind: 'lay', hold: 'hold', tapTok: tok};
  const df = tok.match(/^DF\((\d+)\)$/);
  if (df) return {tap: LAYER_KEYS[df[1]], kind: 'lay', hold: 'default', tapTok: tok};
  if (tok === 'KC_TRNS') return {tap: null, kind: 'trans', tapTok: tok};
  if (tok === 'KC_NO') return {tap: '—', kind: 'plain', tapTok: tok};
  const info = KEY_INFO[tok];
  if (info && info[2]) return {tap: info[2], kind: 'custom', tapTok: tok};  // e.g. dead keys show their glyph
  return {tap: KC[tok] ?? tok.replace(/_/g, ' '), kind: 'plain', tapTok: tok};
}
// one technical name, one human meaning — never both in the same line
function explain(tok) {
  const info = KEY_INFO[tok];
  if (info) return {raw: info[0], what: info[1]};
  const mt = tok.match(/^MT\((MOD_\w+),\s*(\w+)\)$/);
  if (mt) return {raw: tok, what: `Mod-tap — hold: <b>${MODS[mt[1]]}</b> · tap: <b>${KC[mt[2]] ?? mt[2]}</b>`};
  const mo = tok.match(/^MO\((\d+)\)$/);
  if (mo) return {raw: tok, what: `Momentary — hold for layer <b>${LAYER_KEYS[mo[1]]}</b>`};
  const df = tok.match(/^DF\((\d+)\)$/);
  if (df) return {raw: tok, what: `Set default layer: <b>${LAYER_KEYS[df[1]]}</b>`};
  if (tok === 'KC_TRNS') return {raw: tok, what: 'Transparent — passes through to the layer below'};
  const label = KC[tok] ?? tok.replace(/_/g, ' ');
  if (tok.startsWith('KC_')) return {raw: tok, what: `<b>${label}</b>`};
  return {raw: tok, what: `<b>${label}</b> (custom keycode)`};
}

// ---- build ----
const UNIT = 70, PAD = 48;
const canvas = document.getElementById('canvas');
const tabs = document.getElementById('tabs');
const keys = [];          // per layer: array of {el, tok}
let activeLayer = 0, comboMode = false;

DATA.layers.forEach((layer, li) => {
  keys.push(layer.map((tok, ki) => {
    const p = DATA.positions[ki];
    const el = document.createElement('div');
    el.className = 'key';
    el.style.left = (PAD + p.x * UNIT) + 'px';
    el.style.top = (PAD + p.y * UNIT) + 'px';
    const info = parseToken(tok);
    if (info.kind === 'trans') {
      el.classList.add('trans');
      el.innerHTML = '<span class="dot">·</span>';
    } else {
      if (info.kind === 'mt') el.classList.add('mt');
      if (info.kind === 'lay') el.classList.add('lay');
      if (info.kind === 'custom') el.classList.add('custom');
      let face = '';
      const shifted = SHIFTED[info.tapTok ?? tok];
      if (shifted) face += `<span class="shifted">${shifted}</span>`;
      face += `<span class="tap">${info.tap}</span>`;
      if (info.hold) face += `<span class="hold">${info.hold}</span>`;
      el.innerHTML = face;
    }
    const obj = {el, tok, li, ki};
    el.addEventListener('mouseenter', e => { showTip(e, li, ki); if (comboMode && li === 0) highlightChips(tok); });
    el.addEventListener('mouseleave', () => { hideTip(); clearChips(); });
    canvas.appendChild(el);
    return obj;
  }));
});
canvas.style.width = (2 * PAD + 16 * UNIT) + 'px';
canvas.style.height = (2 * PAD + 8 * UNIT) + 'px';

LAYER_NAMES.forEach((name, i) => {
  const t = document.createElement('div');
  t.className = 'tab' + (i === 0 ? ' active' : '');
  t.textContent = name;
  t.onclick = () => selectLayer(i);
  tabs.appendChild(t);
});

function selectLayer(li) {
  activeLayer = li;
  save('layer', li);
  [...tabs.children].forEach((t, i) => t.classList.toggle('active', i === li));
  keys.forEach((layer, l) => layer.forEach(k => { k.el.style.display = l === li ? '' : 'none'; }));
  paint();
  if (comboMode && li === 0) drawComboBadges(); else clearComboBadges();
}
function schemeFor(layerIdx, tok) {
  const map = LAYER_COLORS[LAYER_NAMES[layerIdx]];
  if (!map) return null;
  if (tok in map) return map[tok];
  if (tok === 'KC_TRNS' || tok === 'KC_NO') return null;
  // F-keys inherit the canonical colors registered on the F-key layer
  if (tok.startsWith('KC_F') && FKEY_COLORS && tok in FKEY_COLORS) return FKEY_COLORS[tok];
  return map.default ?? null;
}
function paint() {
  const light = document.body.classList.contains('light');
  keys[activeLayer].forEach(k => {
    if (k.tok === 'KC_TRNS') return;
    const sc = schemeFor(activeLayer, k.tok);
    if (sc) {
      k.el.style.background = light ? sc.fillL : sc.fillD;
      k.el.style.borderColor = sc.border;
      k.el.style.color = light ? sc.textL : sc.textD;
    } else {
      k.el.style.background = ''; k.el.style.borderColor = ''; k.el.style.color = '';
    }
  });
}
// F15 mode: result glyphs around each participating key, colored by accent type;
// trigger keys get an inner ring in their accent color.
const TYPE_ORDER = ['grave', 'acute', 'circumflex', 'trema', 'cedilla'];
const KEY_RESULTS = {};
COMBOS.forEach(([a, b, res, type]) => {
  (KEY_RESULTS[a] = KEY_RESULTS[a] || []).push({res, type});
  (KEY_RESULTS[b] = KEY_RESULTS[b] || []).push({res, type});
});
Object.values(KEY_RESULTS).forEach(l => l.sort((x, y) => TYPE_ORDER.indexOf(x.type) - TYPE_ORDER.indexOf(y.type)));
const BADGE_POS = {
  1: ['top-left'],
  2: ['top-left', 'top-right'],
  3: ['top-left', 'top-right', 'bottom-right'],
  4: ['top-left', 'top-right', 'bottom-right', 'bottom-left'],
};
const POS_CSS = {
  'top-left': 'top:4px; left:4px;',
  'top-right': 'top:4px; right:4px;',
  'bottom-right': 'bottom:4px; right:4px;',
  'bottom-left': 'bottom:4px; left:4px;',
};
function drawComboBadges() {
  clearComboBadges();
  keys[0].forEach(k => {
    const results = KEY_RESULTS[k.tok];
    if (!results) return;
    const pos = BADGE_POS[Math.min(results.length, 4)];
    results.forEach((r, i) => {
      const b = document.createElement('span');
      b.className = 'res-badge';
      b.style.borderColor = ACCENT_COLORS[r.type];
      b.style.color = ACCENT_COLORS[r.type];
      b.style.cssText += POS_CSS[pos[i]];
      b.textContent = r.res;
      k.el.appendChild(b);
    });
    if (TRIGGERS[k.tok]) {
      k.el.style.boxShadow = 'inset 0 0 0 2.5px ' + ACCENT_COLORS[TRIGGERS[k.tok]];
    }
  });
}
function clearComboBadges() {
  keys.forEach(layer => layer.forEach(k => {
    k.el.querySelectorAll('.res-badge').forEach(b => b.remove());
    k.el.style.boxShadow = '';
  }));
}

// ---- combo chip panel (under the keyboard) ----
const panel = document.getElementById('comboPanel');
const chipGroups = document.getElementById('chipGroups');
const chips = [];
ACCENT_GROUPS.forEach(group => {
  const g = document.createElement('div');
  g.className = 'chip-group';
  g.innerHTML = `<span class="gname">${group}</span>`;
  COMBOS.forEach(([a, b, res, type, desc]) => {
    if (type !== group) return;
    const chip = document.createElement('div');
    chip.className = 'chip';
    chip.style.borderColor = ACCENT_COLORS[type];
    chip.title = desc;
    chip.innerHTML = `<span class="keys">${KC[a]}${KC[b]}</span><span class="arrow">→</span><span class="res">${res}</span>`;
    chip.addEventListener('mouseenter', () => markKeys(a, b));
    chip.addEventListener('mouseleave', unmarkKeys);
    chips.push({el: chip, a, b, type});
    g.appendChild(chip);
  });
  chipGroups.appendChild(g);
});
function markKeys(a, b) {
  keys[0].forEach(k => {
    if (k.tok === a || k.tok === b) k.el.classList.add('involved');
  });
}
function unmarkKeys() {
  keys.forEach(layer => layer.forEach(k => k.el.classList.remove('involved')));
}
function highlightChips(tok) {
  chips.forEach(c => {
    c.el.classList.toggle('involve', c.a === tok || c.b === tok);
    c.el.classList.toggle('dim', c.a !== tok && c.b !== tok);
  });
}
function clearChips() {
  chips.forEach(c => c.el.classList.remove('involve', 'dim'));
}

// ---- tooltip ----
const tip = document.getElementById('tip');
function showTip(e, li, ki) {
  const k = keys[li][ki];
  const ex = explain(k.tok);
  tip.innerHTML = `<div class="raw">${ex.raw} · ${LAYER_NAMES[li]}</div>
    <div class="what">${ex.what}</div>`;
  if (comboMode && li === 0) {
    const roles = COMBOS.filter(c => c[0] === k.tok || c[1] === k.tok)
                        .map(c => `${KC[c[0]]}+${KC[c[1]]} → ${c[2]}`)
                        .join(' · ');
    if (roles) tip.innerHTML += `<div class="combo-list">Combo roles (hold F15): ${roles}</div>`;
  }
  tip.style.display = 'block';
  const pad = 14;
  let x = e.clientX + pad, y = e.clientY + pad;
  const r = tip.getBoundingClientRect();
  if (x + r.width > innerWidth) x = e.clientX - r.width - pad;
  if (y + r.height > innerHeight) y = e.clientY - r.height - pad;
  tip.style.left = x + 'px'; tip.style.top = y + 'px';
}
function hideTip() { tip.style.display = 'none'; }

// ---- F15 toggle ----
const f15 = document.getElementById('f15');
f15.onclick = () => {
  setComboMode(!comboMode);
};
function setComboMode(on) {
  comboMode = on;
  f15.classList.toggle('on', on);
  document.getElementById('banner').classList.toggle('on', on);
  panel.classList.toggle('on', on);
  clearChips();
  save('combo', on);
  if (on && activeLayer === 0) drawComboBadges(); else clearComboBadges();
}

// ---- theme toggle ----
const themeBtn = document.getElementById('themeBtn');
function setTheme(light) {
  document.body.classList.toggle('light', light);
  themeBtn.textContent = light ? '☀️' : '🌙';
  save('theme', light);
  if (typeof paint === 'function') paint();
}
themeBtn.onclick = () => setTheme(!document.body.classList.contains('light'));

// ---- persistence (layer / F15 / theme) through localStorage ----
const STORE_KEY = 'keymap-html:' + DATA.keyboard + ':' + DATA.keymap;
function loadState() {
  try { return JSON.parse(localStorage.getItem(STORE_KEY)) || {}; } catch (e) { return {}; }
}
function save(k, v) {
  try {
    const s = loadState();
    s[k] = v;
    localStorage.setItem(STORE_KEY, JSON.stringify(s));
  } catch (e) { /* storage unavailable: ignore */ }
}

const state = loadState();
document.body.classList.toggle('light', !!state.theme);
themeBtn.textContent = state.theme ? '☀️' : '🌙';
const startLayer = (typeof state.layer === 'number' && state.layer >= 0 && state.layer < LAYER_NAMES.length)
  ? state.layer : 0;
selectLayer(startLayer);
if (state.combo) setComboMode(true);
</script>
</body>
</html>
"""


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-kb", "--keyboard", required=True, help="keyboard, e.g. splitkb/halcyon/elora")
    ap.add_argument("-km", "--keymap", required=True, help="keymap name, e.g. colemakdh_hlc")
    ap.add_argument("-o", "--output", help="output HTML file (default: <userspace>/viz/<kb>/<km>/keymap.html)")
    ap.add_argument("--layout", help="layout macro name (default: whatever the keymap.c uses)")
    ap.add_argument("--halcyon-modules", action="store_true",
                    help="keep the halcyon-module slot row even if no HLC_* modules are detected")
    ap.add_argument("--triggers", nargs="*", metavar="KC_X:accent",
                    help="override combo trigger keys, e.g. --triggers KC_H:circumflex KC_M:trema KC_N:acute")
    args = ap.parse_args()

    roots = qmk_roots()
    userspace_root = roots[0] if (roots[0] / "keyboards").is_dir() else (roots[1] if len(roots) > 1 else roots[0])
    keymap_c_path = find_keymap_c(args.keyboard, args.keymap, roots)
    kb = resolve_kb(args.keyboard, roots)
    keymap_dir = keymap_c_path.parent

    keymap_c = keymap_c_path.read_text(errors="replace")
    layer_names = extract_layer_names(keymap_c)
    if not layer_names:
        layer_names = [f"L{i}" for i in range(6)]
    macros = load_object_macros(keymap_dir, keymap_c)
    expanded = expand(keymap_c, macros)
    for idx, name in enumerate(layer_names):
        expanded = re.sub(rf"\b_{re.escape(name)}\b", str(idx), expanded)

    if not shutil.which("qmk"):
        sys.exit("qmk CLI not found on PATH — required to convert keymap.c to keymap.json")
    tmp = pathlib.Path(tempfile.mkdtemp(prefix="keymap-html-"))
    (tmp / "keymap_expanded.c").write_text(expanded)
    keymap_json_path = tmp / "keymap.json"
    run(["qmk", "c2json", "--no-cpp", "-kb", kb, "-km", args.keymap,
         str(tmp / "keymap_expanded.c"), "-o", str(keymap_json_path)])

    keymap_json = json.loads(keymap_json_path.read_text())
    layout_name = args.layout or keymap_json.get("layout")
    if not layout_name:
        sys.exit("could not determine the layout macro used by the keymap")
    layout_json_path, layout_name = find_layout_json(layout_name, kb, roots)
    layout_entries = json.loads(Path(layout_json_path).read_text())["layouts"][layout_name]["layout"]

    # --- halcyon module row (same auto-detection as keymap-viz) -------------
    modules = halcyon_modules_present(keymap_dir)
    keep_module_row = args.halcyon_modules or bool(modules)
    mod_indices = module_slot_indices(layout_entries) if not keep_module_row else []
    if mod_indices:
        keep = [i for i in range(len(layout_entries)) if i not in set(mod_indices)]
        layers = [[t for i, t in enumerate(layer) if i in keep] for layer in keymap_json["layers"]]
        positions = [layout_entries[i] for i in keep]
        print(f"module row: hidden ({len(mod_indices)} keys, no HLC modules detected — use --halcyon-modules to keep)")
    else:
        layers = keymap_json["layers"]
        positions = layout_entries
        if keep_module_row:
            print(f"module row: shown ({'--halcyon-modules' if args.halcyon_modules else 'HLC modules: ' + ', '.join(modules)})")

    base_tokens = layers[0]

    # --- derive annotations from the sources --------------------------------
    custom_functions = (keymap_dir / "custom_functions.c")
    key_info, results, layer_colors = {}, {}, {}
    if custom_functions.is_file():
        cf = custom_functions.read_text(errors="replace")
        actions = parse_key_actions(cf)
        key_info = derive_key_info(actions)
        results = derive_results(actions)
        layer_colors = parse_layer_colors(cf, macros, layer_names)

    combos = []
    combos_c = keymap_dir / "combos.c"
    if combos_c.is_file():
        combos = parse_combos(combos_c.read_text(errors="replace"), base_tokens, results, layer_names[0])
    triggers = parse_triggers(combos_c.read_text(errors="replace") if combos_c.is_file() else "", combos, args.triggers)

    data = {
        "layerNames": layer_names,
        "keyboard": kb,
        "keymap": args.keymap,
        "fkeyLayer": next((n for n in ("FKEYS", "FUNCTION") if n in layer_names), ""),
        "layers": layers,
        "positions": positions,
        "keyInfo": key_info,
        "layerColors": layer_colors,
        "combos": combos,
        "triggers": triggers,
        "kcLabels": KC_LABELS,
        "modLabels": MOD_LABELS,
        "shifted": {
            "KC_1": "!", "KC_2": "@", "KC_3": "#", "KC_4": "$", "KC_5": "%", "KC_6": "^",
            "KC_7": "&", "KC_8": "*", "KC_9": "(", "KC_0": ")", "KC_MINUS": "_", "KC_EQL": "+",
            "KC_LBRC": "{", "KC_RBRC": "}", "KC_GRV": "~", "KC_SCLN": ":", "KC_QUOTE": '"',
            "KC_COMM": "<", "KC_DOT": ">", "KC_SLSH": "?", "KC_NUBS": "|", "KC_NUHS": "~",
            "UD_GRV": "~",
        },
    }

    outfile = Path(args.output) if args.output else userspace_root / "viz" / kb / args.keymap / "keymap.html"
    outfile.parent.mkdir(parents=True, exist_ok=True)
    html = TEMPLATE.replace("__DATA__", json.dumps(data)).replace("__TITLE__", f"{args.keymap} — {kb}").replace(
        "__KEYMAP__", args.keymap).replace("__KEYBOARD__", kb)
    outfile.write_text(html, encoding="utf-8")

    print(f"keyboard : {kb}")
    print(f"keymap   : {args.keymap} ({keymap_c_path})")
    print(f"layout   : {layout_name} ({layout_json_path})")
    print(f"layers   : {', '.join(layer_names)}")
    if combos:
        print(f"combos   : {len(combos)} accent chords (drawn on {layer_names[0]}, require F15)")
    if triggers:
        print(f"triggers : {', '.join(f'{k}={v}' for k, v in triggers.items())}")
    print(f"html     : {outfile}")


if __name__ == "__main__":
    main()
