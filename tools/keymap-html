# --- qmk plumbing (same as tools/keymap-viz) ---------------------------------

def run(cmd, **kw):
    proc = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if proc.returncode != 0:
        sys.stderr.write(f"$ {' '.join(cmd)}\n{proc.stderr[-4000:]}\n")
        sys.exit(f"command failed: {' '.join(cmd[:2])}")
    return proc


def qmk_roots():
    def from_env():
        return {"overlay": os.environ.get("QMK_USERSPACE"), "home": os.environ.get("QMK_HOME")}

    def from_ini():
        out = {}
        path = Path("~/.config/qmk/qmk.ini").expanduser()
        if path.is_file():
            cp = configparser.ConfigParser()
            cp.read(path)
            if cp.has_section("user"):
                out["overlay"] = cp.get("user", "overlay_dir", fallback=None)
                out["home"] = cp.get("user", "qmk_home", fallback=None)
        return out

    env, ini = from_env(), from_ini()
    overlay = env["overlay"] or ini["overlay"]
    home = env["home"] or ini["home"]
    if not (overlay or home) and shutil.which("qmk"):
        try:
            proc = subprocess.run(["qmk", "config"], capture_output=True, text=True, timeout=15)
            cfg = dict(line.split("=", 1) for line in proc.stdout.splitlines() if "=" in line)
            overlay = overlay or cfg.get("user.overlay_dir")
            home = home or cfg.get("user.qmk_home")
        except Exception:
            pass
    roots = [Path(p) for p in (overlay, home) if p]
    if not roots:
        sys.exit("cannot locate QMK directories (set QMK_USERSPACE/QMK_HOME or run `qmk config`)")
    return roots


def find_keymap_c(kb, km, roots):
    parts = kb.split("/")
    kb_variants = ["/".join(parts[:i]) for i in range(len(parts), 0, -1)]
    for root in roots:
        for variant in kb_variants:
            cand = root / "keyboards" / variant / "keymaps" / km / "keymap.c"
            if cand.is_file():
                return cand
    sys.exit(f"keymap.c not found for -kb {kb} -km {km} (searched userspace + qmk_home)")


def resolve_kb(kb, roots):
    parts = kb.split("/")
    for root in roots:
        base = root / "keyboards" / kb
        if not base.is_dir():
            continue
        if re.match(r"^rev\d+$", parts[-1]):
            return kb
        revs = sorted(d.name for d in base.iterdir() if d.is_dir() and re.match(r"^rev\d+$", d.name))
        if revs:
            sys.stderr.write(f"note: -kb {kb} not found directly, using {kb}/{revs[0]}\n")
            return f"{kb}/{revs[0]}"
        if (base / "info.json").is_file() or (base / "keyboard.json").is_file():
            return kb
    qmk = shutil.which("qmk")
    if qmk:
        listed = subprocess.run([qmk, "list-keyboards"], capture_output=True, text=True).stdout.split()
        matches = sorted(n for n in listed if n.startswith(kb + "/"))
        if matches:
            sys.stderr.write(f"note: -kb {kb} not found directly, using {matches[0]}\n")
            return matches[0]
    sys.exit(f"keyboard {kb} not found under any QMK keyboards/ tree")


def strip_comments(text):
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    text = re.sub(r"//[^\n]*", "", text)
    return text


def extract_layer_names(keymap_c):
    names = []
    for m in DESIGNATOR_RE.finditer(strip_comments(keymap_c)):
        name = m.group(1)
        if name not in names:
            names.append(name)
    return [n.lstrip("_") for n in names]


def load_object_macros(keymap_dir, keymap_c):
    sources = [strip_comments(keymap_c)]
    for h in sorted(keymap_dir.glob("*.h")):
        sources.append(strip_comments(h.read_text(errors="replace")))
    macros = {}
    for text in sources:
        text = re.sub(r"\\\n\s*", " ", text)
        for m in MACRO_RE.finditer(text):
            name, body = m.group(1), m.group(2).strip()
            if body.startswith("("):
                continue
            macros[name] = body
    return macros


def expand(text, macros, iterations=8):
    for _ in range(iterations):
        new = text
        for name, body in macros.items():
            new = re.sub(rf"\b{re.escape(name)}\b", lambda m, b=body: b, new)
        if new == text:
            return text
        text = new
    return text


def find_layout_json(layout_name, kb, roots):
    kb_parts = kb.split("/")
    kb_base = kb_parts[-2] if re.match(r"^rev\d+$", kb_parts[-1]) else kb_parts[-1]

    def read_json(path):
        try:
            return json.loads(path.read_text())
        except (json.JSONDecodeError, OSError):
            return None

    def find_in(data, name):
        if name == "LAYOUT":
            resolved = data.get("layout_aliases", {}).get("LAYOUT")
            return resolved if resolved in data.get("layouts", {}) else None
        return name if name in data.get("layouts", {}) else None

    if layout_name != "LAYOUT":
        for root in roots:
            cand = root / "layouts" / f"{kb_base}.json"
            if cand.is_file() and find_in(read_json(cand), layout_name):
                return cand, layout_name

    kb_candidates = []
    for root in roots:
        for i in range(len(kb_parts), 0, -1):
            kb_candidates.append(root / "keyboards" / "/".join(kb_parts[:i]) / "info.json")
    for cand in kb_candidates:
        data = read_json(cand)
        resolved = find_in(data, layout_name) if data else None
        if resolved:
            return cand, resolved

    url = f"https://keyboards.qmk.fm/v1/keyboards/{kb}/info.json"
    try:
        data = json.loads(urllib.request.urlopen(url, timeout=10).read())
        if layout_name == "LAYOUT":
            resolved = data.get("layout_aliases", {}).get("LAYOUT")
            layout_name = resolved if resolved in data.get("layouts", {}) else next(iter(data.get("layouts", {})))
        if layout_name in data.get("layouts", {}):
            with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
                json.dump(data, f)
                return pathlib.Path(f.name), layout_name
    except Exception as exc:
        sys.exit(f"layout {layout_name} not found locally or via {url} ({exc})")
    sys.exit(f"layout {layout_name} not found in any known info.json")


def halcyon_modules_present(keymap_dir):
    text = ""
    for f in keymap_dir.iterdir():
        if f.is_file() and (f.suffix in (".h", ".c") or f.name in ("rules.mk", "config.h", "keymap.c")):
            text += f.read_text(errors="replace") + "\n"
    found = []
    for m in re.finditer(r"^\s*#\s*(?:define|ifdef|ifndef)\s+(HLC_\w+)", text, re.M):
        if m.group(1) not in ("HLC_NONE",) and m.group(1) not in found:
            found.append(m.group(1))
    return found


def module_slot_indices(layout_entries):
    ys = {}
    for i, k in enumerate(layout_entries):
        ys.setdefault(round(float(k.get("y", 0)), 3), []).append(i)
    if not ys:
        return []
    max_y = max(ys)
    idxs = ys[max_y]
    others = [y for y in ys if y != max_y]
    if len(idxs) == 10 and others and (max_y - max(others)) >= 1.0:
        return idxs
    return []


# --- derive keymap-specific data from the sources ----------------------------

def parse_key_actions(custom_functions_c):
    """case E_ACUTE: return accented_letter(KC_QUOT, KC_E, pressed); -> {E_ACUTE: (fn, args)}
    Also handles the CTL_QUOT tap-count undead pattern and `send_chord(mods, key)`
    editor/prefix commands."""
    actions = {}
    for m in re.finditer(r"case\s+(\w+):\s*return\s+(\w+)\(([^;]+?)\);", custom_functions_c):
        tok, fn = m.group(1), m.group(2)
        args = [a.strip() for a in m.group(3).split(",") if a.strip()]
        actions[tok] = (fn, args)
    for m in re.finditer(r"case\s+(\w+):\s*if\s*\(record->tap\.count\s*>\s*0\)\s*\{\s*return\s+undead\(([\w()]+),\s*pressed\);", custom_functions_c):
        actions[m.group(1)] = ("undead", [m.group(2)])
    for m in re.finditer(r"case\s+(\w+):\s*(?:/[^\n]*)?\s*if\s*\(pressed\)\s*send_chord\(([^;]+)\);", custom_functions_c):
        args = [a.strip() for a in m.group(2).split(",") if a.strip()]
        actions[m.group(1)] = ("send_chord", args)
    return actions


def accent_type_for(accent_kc, letter_kc):
    if accent_kc == "KC_GRV":
        return "grave"
    if accent_kc == "S(KC_6)":
        return "circumflex"
    if accent_kc == "S(KC_QUOT)":
        return "trema"
    if accent_kc == "KC_QUOT":
        return "cedilla" if letter_kc == "KC_C" else "acute"
    return None


def derive_key_info(actions):
    """token -> [name, html description, optional tap label]"""
    info = {}
    for tok, (fn, args) in actions.items():
        if fn == "undead" and args:
            ch = UNDEAD_TAPS.get(args[0], args[0])
            info[tok] = [tok, f"Undead <b>{ch}</b> — dead key + space (types immediately; the accent applies to the next letter)", ch]
        elif fn == "accented_letter" and len(args) >= 2:
            accent, letter = args[0], args[1]
            base = letter.replace("KC_", "").lower()
            atype = accent_type_for(accent, letter)
            composed = COMPOSED.get(base, {}).get(atype, "")
            accent_label = UNDEAD_TAPS.get(accent, accent)
            desc = f"Accented <b>{composed}</b> — {accent_label} + {base}"
            info[tok] = [tok, desc]
        elif fn == "send_chord" and len(args) >= 2:
            mods, key = args[0], args[1]
            mod_key = {
                "MOD_LCTL": "Ctrl", "MOD_LSFT": "Shift", "MOD_LALT": "Alt", "MOD_LGUI": "Win",
                "MOD_RCTL": "RCtrl", "MOD_RSFT": "RShift", "MOD_RALT": "RAlt", "MOD_RGUI": "RWin",
                "MOD_MEH": "Meh", "MOD_HYPR": "Hyper",
            }
            mod_names = [mod_key.get(x.strip(), x.strip()) for x in mods.split("|")]
            key_label = KC_LABELS.get(key, key)
            chord = "+".join(mod_names + [key_label])
            info[tok] = [tok, f"Sends <b>{chord}</b>"]
    for tok, desc in RM_DESC.items():
        info.setdefault(tok, [tok, desc])
    # short on-key labels for tokens whose names would overflow a keycap
    for tok, tap in TAP_OVERRIDES.items():
        if tok in info:
            info[tok].append(tap)
    # generic fallback for other custom tokens: humane word-split label
    def humane(tok):
        label = tok.replace("EDIT_", "").replace("APP_", "").replace("PREFIX_", "")
        label = label.replace("_", " ").title()
        label = label.replace("Selall", "Select All").replace("Devtools", "Devtools")
        return label

    for tok in list(info.keys()):
        if len(info[tok]) < 3:
            words = humane(tok).split()
            if len(words) > 2:
                mid = (len(words) + 1) // 2
                tap = "<br>".join(words[:mid]) + "<br>" + " ".join(words[mid:])
            else:
                tap = "<br>".join(words)
            info[tok].append(tap)
    return info


def derive_results(actions):
    """custom keycode -> accented result char (for combos)."""
    results = {}
    for tok, (fn, args) in actions.items():
        if fn == "accented_letter" and len(args) >= 2:
            base = args[1].replace("KC_", "").lower()
            atype = accent_type_for(args[0], args[1])
            composed = COMPOSED.get(base, {}).get(atype)
            if composed:
                results[tok] = composed
    return results


# --- color resolution --------------------------------------------------------

COLOR_MACRO_RE = re.compile(r"^\s*#define\s+(\w+)\s+([^\s,]+)\s*,\s*([^\s,]+)\s*,\s*([^\s,]+)", re.M)
COLOR_ALIAS_RE = re.compile(r"^\s*#define\s+(\w+)\s+(\w+)\s*$", re.M)
NUM_RE = re.compile(r"^(\d+|0x[0-9a-fA-F]+)$")


def resolve_color_constants(custom_functions_c):
    """Resolve `#define C_* r, g, b` macros (incl. aliases like `C_COMBO_ACUTE C_GOLD`)
    into {name: (r, g, b)}."""
    values = {}   # name -> (r, g, b)
    aliases = {}  # name -> reference name
    for m in COLOR_ALIAS_RE.finditer(custom_functions_c):
        # alias lines: exactly two tokens with nothing else on the line
        line = custom_functions_c[:m.start()].count("\n")
        if m.start() and custom_functions_c[m.start() - 1] == "\n" and (m.end() == len(custom_functions_c) or custom_functions_c[m.end():m.end() + 60].lstrip().startswith("//")):
            pass
    # simpler: two passes — pure r,g,b lines, then aliases
    for m in COLOR_MACRO_RE.finditer(custom_functions_c):
        parts = (m.group(1), m.group(2), m.group(3))
        nums = []
        ok = True
        for v in (m.group(2), m.group(3), m.group(4)):
            if NUM_RE.match(v):
                nums.append(int(v, 0))
            else:
                ok = False
        if ok:
            values[m.group(1)] = tuple(nums)
    for m in re.finditer(r"^\s*#define\s+(\w+)\s+(\w+)\s*(//.*)?$", custom_functions_c, re.M):
        name, ref = m.group(1), m.group(2)
        if ref in values and name not in values:
            values[name] = values[ref]
    return values


def parse_layer_colors(custom_functions_c, macros, layer_names):
    """register_color_for_keycode(_NAV, KC_HOME, 0, 255, 0) calls ->
    {layer: {token: spec}} with RGB_WILDCARD as 'default'. Spec carries
    dark/light fill + border + text colors for both themes. Color values may be
    numeric literals or C_* macro names."""
    color_consts = resolve_color_constants(custom_functions_c)
    scheme, wild = {}, {}
    for m in re.finditer(r"register_color_for_keycode\((\w+),\s*([\w()]+),\s*([^)]+)\)", custom_functions_c):
        layer = m.group(1).lstrip("_")
        tok = expand(m.group(2), macros)
        # resolve layer-enum names (GAMING -> DF(_GAMING) -> DF(2))
        for idx, name in enumerate(layer_names):
            tok = re.sub(rf"\b_{re.escape(name)}\b", str(idx), tok)
        arg = m.group(3).replace(" ", "")
        # arg is either "r, g, b" or a C_* color macro name
        if re.match(r"^[0-9]+\s*,\s*[0-9]+\s*,\s*[0-9]+$", m.group(3)):
            rgb = tuple(int(x) for x in re.split(r"\s*,\s*", m.group(3)))
        else:
            rgb = color_consts.get(arg)
        if rgb is None:
            continue
        if tok == "RGB_WILDCARD":
            wild[layer] = rgb
        else:
            scheme.setdefault(layer, {})[tok] = rgb

    def spec(rgb):
        r, g, b = rgb
        return {
            "fillD": "#%02x%02x%02x" % tuple(int(c * 0.22) for c in rgb),
            "fillL": "#%02x%02x%02x" % tuple(int(c + (255 - c) * 0.75) for c in rgb),
            "border": "#%02x%02x%02x" % rgb,
            "textD": "#%02x%02x%02x" % tuple(int(c + (255 - c) * 0.6) for c in rgb),
            "textL": "#%02x%02x%02x" % tuple(int(c * 0.4) for c in rgb),
        }

    out = {}
    for layer, toks in scheme.items():
        out[layer] = {t: spec(rgb) for t, rgb in toks.items()}
        if layer in wild:
            out[layer]["default"] = spec(wild[layer])
    return out


def parse_combos(combos_c, base_tokens, results, layer_name):
    """combos.c -> [[keyA, keyB, resultChar, accentType, description], ...]"""
    combos = []
    arrays = dict(re.findall(r"const\s+uint16_t\s+PROGMEM\s+(\w+)\[\]\s*=\s*\{(.*?)\};", combos_c, re.S))
    for _, arr_name, result in re.findall(r"\[(\w+)\]\s*=\s*COMBO\(\s*(\w+)\s*,\s*(\w+)\s*\)", combos_c):
        keys = re.findall(r"\b(KC_\w+)\b", arrays.get(arr_name, ""))
        if len(keys) < 2 or result not in results:
            continue
        idxs = []
        for k in keys:
            try:
                idxs.append(base_tokens.index(k))
            except ValueError:
                idxs = None
                break
        if not idxs:
            continue
        ch = results[result]
        atype = CHAR_TYPE.get(ch, "")
        desc = f"{KC_LABELS.get(keys[0], keys[0])} + {KC_LABELS.get(keys[1], keys[1])} → {ch} ({atype})"
        combos.append([keys[0], keys[1], ch, atype, desc])
    return combos


def parse_triggers(combos_c, combos, overrides=None):
    """Trigger keys — automatic:
      - comment-declared: `X = <accent> trigger/partner` lines in combos.c
      - heuristic for undeclared accent types:
          * >=2 chords of one accent type: the key that starts all of them
          * exactly 1 chord: the consonant of a vowel+consonant pair
    CLI overrides (--triggers) always win."""
    VOWEL_KC = {"KC_A", "KC_E", "KC_I", "KC_O", "KC_U", "KC_Y"}
    trig = {}
    for m in re.finditer(r"([A-Z]{1,6}) = (\w+)[^\n]*(?:trigger|partner)", combos_c):
        key, word = "KC_" + m.group(1), m.group(2)
        if word in ACCENT_TYPES:
            trig[key] = word
    by_type = {}
    for a, b, _ch, atype, _desc in combos:
        by_type.setdefault(atype, []).append((a, b))
    for atype, pairs in by_type.items():
        if atype in trig.values():
            continue
        if len(pairs) >= 2:
            firsts = {p[0] for p in pairs}
            if len(firsts) == 1:
                trig[next(iter(firsts))] = atype
        elif len(pairs) == 1:
            a, b = pairs[0]
            vowel, other = (a, b) if a in VOWEL_KC else ((b, a) if b in VOWEL_KC else (None, None))
            if vowel and other not in VOWEL_KC:
                trig[other] = atype
    for spec in overrides or []:
        if ":" in spec:
            key, word = spec.split(":", 1)
            trig[key.strip()] = word.strip()
    return trig


